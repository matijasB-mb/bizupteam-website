# Contact form delivery (Resend). Without these the form validates and
# rate-limits normally but tells the visitor that sending is not yet active
# and points them at the phone number instead — it never fakes a send.
#
# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit a real key.

RESEND_API_KEY=
CONTACT_FROM_EMAIL=          # verified sender, e.g. web@bizupteam.hr
CONTACT_TO_EMAIL=            # optional; defaults to webshop@bizupteam.hr
